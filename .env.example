# Required public identifiers for the storefront and embedded Sanity Studio.
# These are identifiers, not secrets, and must be available during the build.
NEXT_PUBLIC_SANITY_PROJECT_ID="vrf1c084"
NEXT_PUBLIC_SANITY_DATASET="production"

# Required only for the Product and Guide Assistants. Keep the API key server-side.
# Never rename it with a NEXT_PUBLIC_ prefix or expose its value in client code.
GEMINI_API_KEY=""

# Optional. The assistants use this model by default when the variable is omitted.
GEMINI_MODEL="gemini-3.6-flash"

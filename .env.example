# Required public identifiers for the storefront and embedded Sanity Studio.
# These are identifiers, not secrets, and must be available during the build.
NEXT_PUBLIC_SANITY_PROJECT_ID="vrf1c084"
NEXT_PUBLIC_SANITY_DATASET="production"

# Required only for the Product and Guide Assistants. Keep the API key server-side.
# Never rename it with a NEXT_PUBLIC_ prefix or expose its value in client code.
GEMINI_API_KEY=""

# Optional. The assistants use this model by default when the variable is omitted.
GEMINI_MODEL="gemini-3.6-flash"

# Supabase account authentication. The publishable values are safe in browser
# code; SUPABASE_SECRET_KEY must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend marketing contact synchronization. Use a dedicated server-only API key,
# the ID of the "MishBaby Updates" segment, and the signing secret from the
# Resend webhook configured for contact.updated and contact.deleted events.
RESEND_MARKETING_API_KEY=""
RESEND_MARKETING_SEGMENT_ID=""
RESEND_WEBHOOK_SECRET=""
